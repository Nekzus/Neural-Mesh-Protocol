{
	"compilerOptions": {
		"rootDir": ".",
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": true,
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"types": ["node", "vitest/globals", "vitest"],
		"paths": {
			"@nekzus/liop": ["./src/index.ts"],
			"@nekzus/liop/*": ["./src/*"]
		}
	},
	"include": ["src/**/*", "tests/**/*", "scripts/**/*.ts"],
	"exclude": ["node_modules", "dist", "tests/infra/playground-web"]
}
